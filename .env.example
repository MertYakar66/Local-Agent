# =====================================================
# Autonomous Browser Agent Configuration
# =====================================================
# Copy this file to .env and fill in your settings

# =====================================================
# LLM Provider: "claude" (cloud) or "ollama" (local)
# =====================================================
LLM_PROVIDER=claude

# =====================================================
# Claude API Settings (when LLM_PROVIDER=claude)
# =====================================================
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
CLAUDE_MODEL=claude-sonnet-4-20250514

# =====================================================
# Ollama Settings (when LLM_PROVIDER=ollama)
# =====================================================
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3-vl:8b
FALLBACK_MODEL_NAME=qwen3-vl:30b
FALLBACK_AFTER_FAILURES=3

EMBEDDING_MODEL=nomic-embed-text

# =====================================================
# Browser Settings
# =====================================================
HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
MAX_TABS=10

# =====================================================
# Safety Settings
# =====================================================
REQUIRE_APPROVAL_FOR_SENSITIVE=true
MAX_RETRIES_PER_ACTION=3
ACTION_CONFIDENCE_THRESHOLD=0.8

# Performance Settings
MAX_VRAM_GB=15.0

# =====================================================
# Logging
# =====================================================
LOG_DIR=./logs
LOG_LEVEL=INFO
