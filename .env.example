# Ollama Configuration
OLLAMA_URL=http://localhost:11434

# Tiered Intelligence - Dual Model System
# Primary model (8b): Fast, handles 95% of tasks (~40-60 tokens/sec, ~6-7GB VRAM)
MODEL_NAME=qwen3-vl:8b
# Fallback model (30b): Smarter, invoked after consecutive failures (~3-8 tokens/sec)
FALLBACK_MODEL_NAME=qwen3-vl:30b
# Number of consecutive failures before switching to fallback
FALLBACK_AFTER_FAILURES=3

EMBEDDING_MODEL=nomic-embed-text

# Browser Settings
HEADLESS=true
MAX_TABS=10
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Safety Settings
REQUIRE_APPROVAL_FOR_SENSITIVE=true
MAX_RETRIES_PER_ACTION=3
ACTION_CONFIDENCE_THRESHOLD=0.8

# Performance Settings
MAX_VRAM_GB=15.0

# Logging
LOG_LEVEL=INFO
SAVE_SCREENSHOTS=true
