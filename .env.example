# =====================================================
# Autonomous Browser Agent Configuration
# =====================================================
# Copy this file to .env and fill in your settings
#
# =====================================================
# MCP Server Setup (Recommended - uses your subscription!)
# =====================================================
# The MCP server lets Claude Desktop control your local browser.
# Cloud reasoning (your Pro subscription) + local execution = $0 API tokens
#
# 1. Find your Claude Desktop config file:
#    - macOS: ~/Library/Application Support/Claude/claude_desktop_config.json
#    - Windows: %APPDATA%\Claude\claude_desktop_config.json
#    - Linux: ~/.config/Claude/claude_desktop_config.json
#
# 2. Add this to the config file:
#    {
#      "mcpServers": {
#        "browser-agent": {
#          "command": "python",
#          "args": ["-m", "src.mcp_server"],
#          "cwd": "/full/path/to/Local-Agent"
#        }
#      }
#    }
#
# 3. Restart Claude Desktop
#
# 4. Ask Claude to browse websites:
#    "Go to wikipedia.org and search for artificial intelligence"
#    "Extract all the headings from this page"
#    "Fill in the search box with 'machine learning' and press Enter"
#
# This approach uses your Claude Pro subscription for reasoning
# while the browser automation runs locally on your machine.

# =====================================================
# Standalone Mode: LLM Provider (uses API - billed per token)
# =====================================================
# Only needed if NOT using MCP mode above.
# Set to "claude" to use Claude API, or "ollama" for local models.
LLM_PROVIDER=ollama

# =====================================================
# Claude API Settings (only if LLM_PROVIDER=claude)
# =====================================================
# WARNING: This uses the API and costs money per token!
# For $0 usage, use MCP mode above instead.
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# =====================================================
# Ollama Settings (when LLM_PROVIDER=ollama)
# =====================================================
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3-vl:8b
FALLBACK_MODEL_NAME=qwen3-vl:30b
FALLBACK_AFTER_FAILURES=3

EMBEDDING_MODEL=nomic-embed-text

# =====================================================
# Browser Settings
# =====================================================
HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
MAX_TABS=10

# =====================================================
# Safety Settings
# =====================================================
REQUIRE_APPROVAL_FOR_SENSITIVE=true
MAX_RETRIES_PER_ACTION=3
ACTION_CONFIDENCE_THRESHOLD=0.8

# Performance Settings
MAX_VRAM_GB=15.0

# =====================================================
# Logging
# =====================================================
LOG_DIR=./logs
LOG_LEVEL=INFO
